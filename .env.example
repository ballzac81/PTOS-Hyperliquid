# ═══════════════════════════════════════════════════════════════
#  PTOS -- Hyperliquid Edition  |  Configuration
#  Edit this file, then run: docker compose restart
# ═══════════════════════════════════════════════════════════════


# ── REQUIRED ────────────────────────────────────────────────────
# How to get your keys:
#   1. Go to app.hyperliquid.xyz -> Settings -> API
#   2. Click "Generate API Wallet" -- this creates a sub-wallet for trading
#   3. Copy the PRIVATE KEY of the API wallet into HL_PRIVATE_KEY below
#   4. Copy your MAIN wallet address (shown top-right of the HL app)
#      into HL_WALLET_ADDRESS below
#
# Why two values?
#   The API wallet signs your orders (limited permissions -- cannot withdraw).
#   The main wallet is where your USDC balance actually lives.
#   The bot signs with the API key but trades against your main wallet's funds.
#   This is the safest setup -- never put your main wallet private key in here.
#
# IMPORTANT -- Account type:
#   Go to app.hyperliquid.xyz/portfolio -> Account Type button -> select MANUAL.
#   Then transfer your USDC from spot to your perp account via Balances -> Transfer.
#   The bot reads perp margin only -- Unified/Portfolio Margin modes will show
#   $0 equity and every trade will fail with "size below minimum".
#
HL_PRIVATE_KEY=0xYOUR_API_WALLET_PRIVATE_KEY
HL_WALLET_ADDRESS=0xYOUR_MAIN_WALLET_PUBLIC_ADDRESS

# Secret token -- paste the same value into every TradingView alert
SECRET_TOKEN=your_random_secret_token


# ── NETWORK ─────────────────────────────────────────────────────
# true  = testnet (paper trading, safe to experiment)
# false = mainnet (REAL MONEY -- only flip when ready)
HL_TESTNET=true


# ── POSITION SIZING ─────────────────────────────────────────────
# Fraction of your account equity used per trade
#   0.10 = 10%  |  0.25 = 25%  |  0.50 = 50%
POSITION_SIZE_PCT=0.10

# Leverage multiplier (1 = no leverage)
LEVERAGE=3

# cross = shared margin across all positions
# isolated = each position has its own margin (limits max loss per trade)
LEVERAGE_MODE=cross


# ── SELL BEHAVIOUR ──────────────────────────────────────────────
# What happens when sell-signal + trend-down both fire:
#
#   short      -> close any open long, then open a short
#   close_long -> just exit the long and sit in USDC
#   open_short -> open a short without touching the long
#
SELL_MODE=short

# If SELL_MODE=close_long, what fraction of the long to close:
SELL_PCT=1.0


# ── SIGNAL WINDOW ───────────────────────────────────────────────
# 0 = no expiry (recommended)
WINDOW_SECONDS=0


# ── TELEGRAM (optional) ─────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=


# ── TRAILING STOP ────────────────────────────────────────────────
TRAILING_STOP_PCT=0.05
MONITOR_INTERVAL_SECONDS=30


# ── COOLDOWN ─────────────────────────────────────────────────────
COOLDOWN_SECONDS=0


# ── SAFETY CAP ───────────────────────────────────────────────────
MAX_POSITION_SIZE_PCT=0.5
