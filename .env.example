# ═══════════════════════════════════════════════════════════════
#  PTOS — Hyperliquid Edition  |  Configuration
#  Edit this file, then run: docker compose restart
# ═══════════════════════════════════════════════════════════════


# ── REQUIRED ────────────────────────────────────────────────────
# How to get your keys:
#   1. Go to app.hyperliquid.xyz -> Settings -> API
#   2. Click "Generate API Wallet" -- this creates a sub-wallet for trading
#   3. Copy the PRIVATE KEY of the API wallet into HL_PRIVATE_KEY below
#   4. Copy your MAIN wallet address (shown top-right of the HL app)
#      into HL_WALLET_ADDRESS below
#
# Why two values?
#   The API wallet signs your orders (limited permissions -- cannot withdraw).
#   The main wallet is where your USDC balance actually lives.
#   The bot signs with the API key but trades against your main wallet's funds.
#   This is the safest setup -- never put your main wallet private key in here.
#
# IMPORTANT -- Account type:
#   Go to app.hyperliquid.xyz/portfolio -> Account Type button -> select MANUAL.
#   Then transfer your USDC from spot to your perp account via Balances -> Transfer.
#   The bot reads perp margin only -- Unified/Portfolio Margin modes will show
#   $0 equity and every trade will fail with "size below minimum".
#
HL_PRIVATE_KEY=0xYOUR_API_WALLET_PRIVATE_KEY
HL_WALLET_ADDRESS=0xYOUR_MAIN_WALLET_PUBLIC_ADDRESS

# Secret token -- paste the same value into every TradingView alert
SECRET_TOKEN=your_random_secret_token


# ── NETWORK ─────────────────────────────────────────────────────
# true  = testnet (paper trading, safe to experiment)
# false = mainnet (REAL MONEY — only flip when ready)
HL_TESTNET=true


# ── POSITION SIZING ─────────────────────────────────────────────
# Fraction of your account equity used per trade
#   0.10 = 10%  |  0.25 = 25%  |  0.50 = 50%
POSITION_SIZE_PCT=0.10

# Leverage multiplier (1 = no leverage)
LEVERAGE=3

# cross = shared margin across all positions
# isolated = each position has its own margin (limits max loss per trade)
LEVERAGE_MODE=cross


# ── SELL BEHAVIOUR ──────────────────────────────────────────────
# What happens when sell-signal + trend-down both fire:
#
#   short      → close any open long, then open a short
#                (stay in the market, profit on the way down)
#
#   close_long → just exit the long and sit in USDC
#                (take profits, no short exposure)
#
#   open_short → open a short without touching the long
#                (advanced: run both sides at once)
#
SELL_MODE=short

# If SELL_MODE=close_long, what fraction of the long to close:
#   1.0 = 100% (full exit)  |  0.5 = 50% (half exit)
SELL_PCT=1.0


# ── SIGNAL WINDOW ───────────────────────────────────────────────
# How long a buy/sell signal stays armed waiting for trend confirmation.
# 0 = no expiry (recommended) — stays armed until trend confirms.
# Each new signal refreshes the timer if you do set a limit.
#
#   0      = no expiry (default)
#   36000  = 10 hours  (good for 1h chart)
#   144000 = 40 hours  (good for 4h chart)
#
WINDOW_SECONDS=0


# ── TELEGRAM (optional) ─────────────────────────────────────────
# Leave blank to disable notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── TRAILING STOP ────────────────────────────────────────────────
# Automatically closes a position if price pulls back X% from its
# best point. Lets winners run — no upside cap.
#
# Example on a long: price runs from $150 → $200, trailing stop is
# at $190 (5% below peak). If price drops to $190 it closes.
# If price keeps running to $250 the stop moves to $237.50.
#
# Same in reverse for shorts.
# Set to 0 to disable (not recommended).
#
TRAILING_STOP_PCT=0.05

# Per-coin trailing stop override (optional).
# Overrides TRAILING_STOP_PCT for a specific coin only.
# Example: HYPE needs a wider stop than BTC.
# Format: {COIN}_TRAILING_STOP_PCT=0.07
# HYPE_TRAILING_STOP_PCT=0.07
# BTC_TRAILING_STOP_PCT=0.04

# How often to check positions (seconds). 30 is a good default.
MONITOR_INTERVAL_SECONDS=30

# ── STOP LOSS FROM ENTRY ─────────────────────────────────────────
# Closes a position if price drops X% from your ENTRY PRICE.
# Different from trailing stop -- this fires on immediate losing trades
# before the trailing stop has a chance to move. Good for catching
# fakeout signals where the trade goes wrong straight away.
#
# Example: enter long at $100, STOP_LOSS_PCT=0.05 -> exits at $95.
# 0 = disabled (default)
STOP_LOSS_PCT=0

# ── MAX HOLD TIME ────────────────────────────────────────────────
# Auto-close a position after this many seconds regardless of price.
# Useful if you don't want to hold a short over a weekend or a long
# through a major event.
#
#   86400  = 1 day
#   604800 = 7 days
#   0      = disabled (default)
MAX_HOLD_SECONDS=0
# ── RE-ARM AFTER STOP-OUT ────────────────────────────────────────
# If true, after a trailing stop closes a position the bot automatically
# re-arms the same signal direction after a delay -- so if the trend
# confirms again it re-enters without needing a new TradingView signal.
#
# Example (long stopped out):
#   stop fires -> wait REARM_DELAY_SECONDS -> buy signal re-armed
#   -> next /trend-up -> re-enters long
#   -> signal expires via WINDOW_SECONDS if trend-up never comes
#
# Recommended for higher timeframes (4h+). On lower timeframes (30m)
# a wider TRAILING_STOP_PCT is usually safer.
#
# false = disabled (default)
# true  = auto re-arm after delay
REARM_AFTER_STOP=false

# How long to wait before re-arming (seconds).
#   30m chart: 3600  (2 candles)
#   4h chart:  14400 (1 candle)
#   1d chart:  86400 (1 candle)
REARM_DELAY_SECONDS=3600

# ── COOLDOWN ─────────────────────────────────────────────────────
# Seconds to wait after any position closes before accepting new trades.
# Prevents immediate re-entry after a trailing stop or manual close.
# 0 = disabled  |  300 = 5 min  |  900 = 15 min
COOLDOWN_SECONDS=0

# ── SAFETY CAP ───────────────────────────────────────────────────
# Maximum fraction of equity allowed in a single trade (including leverage).
# Overrides POSITION_SIZE_PCT if the calculated size exceeds this.
# 0.5 = 50% of equity (default safety cap)
MAX_POSITION_SIZE_PCT=0.5
