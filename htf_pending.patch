+def _pending_valid(coin: str, side: str) -> bool:
+    """True if the armed signal may still wait for an HTF flip."""
+    if not _is_armed(coin, side):
+        return False
+    if HTF_PENDING_SECONDS <= 0:
+        return True
+    ts = armed.get(coin, {}).get(side)
+    return ts is not None and (time.time() - ts) <= HTF_PENDING_SECONDS
+
+
+def _htf_is_stale(coin: str) -> bool:
+    if HTF_STALE_SECONDS <= 0:
+        return False
+    ts = htf_bias_ts.get(coin)
+    if not ts:
+        return True
+    return (time.time() - ts) >= HTF_STALE_SECONDS
+
+
+def _htf_allows(coin: str, side: str) -> bool:
+    """side is 'long' or 'short'. Stale bias is treated as neutral (both allowed)."""
+    if not HTF_FILTER_ENABLED:
+        return True
+    if _htf_is_stale(coin):
+        return True
+    bias = htf_bias.get(coin)
+    if side == "long":
+        return bias == "bull"
+    if side == "short":
+        return bias == "bear"
+    return False
+
+
+def _htf_label(coin: str) -> str:
+    bias = htf_bias.get(coin, "not set")
+    if _htf_is_stale(coin):
+        return f"{bias} (stale)"
+    return str(bias)
+
+
