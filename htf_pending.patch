+            notifier.send(f"[{c}] HTF bull + pending buy — flipping SHORT to LONG...")
+            result = trader.flip_to_long(c)
+            action = "flip_to_long"
+        else:
+            logger.info(f"[{c}] Pending LONG -- opening LONG")
+            notifier.send(f"[{c}] HTF bull + pending buy — opening LONG...")
+            result = trader.open_long(c)
+            action = "open_long"
+        if COOLDOWN_SECONDS > 0:
+            cooldown_until[c] = time.time() + COOLDOWN_SECONDS
